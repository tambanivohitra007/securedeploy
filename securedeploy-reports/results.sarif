{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "builtin",
          "informationUri": "https://github.com/securedeploy/securedeploy",
          "version": "0.1.0",
          "rules": [
            {
              "id": "missing-csp",
              "name": "Missing Content-Security-Policy header",
              "shortDescription": {
                "text": "Missing Content-Security-Policy header"
              },
              "fullDescription": {
                "text": "No Content-Security-Policy header is present. This increases XSS risk."
              },
              "helpUri": "https://content-security-policy.com/",
              "properties": {
                "tags": [],
                "cwe": [
                  "CWE-79"
                ],
                "precision": "high",
                "problem.severity": "medium"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "missing-hsts",
              "name": "Missing HTTP Strict-Transport-Security header",
              "shortDescription": {
                "text": "Missing HTTP Strict-Transport-Security header"
              },
              "fullDescription": {
                "text": "HSTS is not set. Browsers will not enforce HTTPS connections for this origin."
              },
              "helpUri": "https://owasp.org/www-project-secure-headers/",
              "properties": {
                "tags": [],
                "cwe": [
                  "CWE-319"
                ],
                "precision": "high",
                "problem.severity": "medium"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "missing-x-frame-options",
              "name": "Missing X-Frame-Options or CSP frame-ancestors",
              "shortDescription": {
                "text": "Missing X-Frame-Options or CSP frame-ancestors"
              },
              "fullDescription": {
                "text": "The application does not set X-Frame-Options or CSP frame-ancestors, enabling clickjacking."
              },
              "helpUri": "https://owasp.org/www-community/attacks/Clickjacking",
              "properties": {
                "tags": [],
                "cwe": [
                  "CWE-1021"
                ],
                "precision": "high",
                "problem.severity": "medium"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "missing-referrer-policy",
              "name": "Missing Referrer-Policy header",
              "shortDescription": {
                "text": "Missing Referrer-Policy header"
              },
              "fullDescription": {
                "text": "No Referrer-Policy is set. Sensitive URL parameters may leak to third parties."
              },
              "helpUri": "",
              "properties": {
                "tags": [],
                "cwe": [
                  "CWE-200"
                ],
                "precision": "high",
                "problem.severity": "low"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "missing-x-content-type-options",
              "name": "Missing X-Content-Type-Options header",
              "shortDescription": {
                "text": "Missing X-Content-Type-Options header"
              },
              "fullDescription": {
                "text": "X-Content-Type-Options: nosniff is not set, enabling MIME-type sniffing attacks."
              },
              "helpUri": "",
              "properties": {
                "tags": [],
                "cwe": [
                  "CWE-16"
                ],
                "precision": "high",
                "problem.severity": "low"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "x-powered-by-disclosed",
              "name": "X-Powered-By header discloses technology stack",
              "shortDescription": {
                "text": "X-Powered-By header discloses technology stack"
              },
              "fullDescription": {
                "text": "X-Powered-By: PHP/8.4.24 reveals implementation details."
              },
              "helpUri": "",
              "properties": {
                "tags": [],
                "cwe": [
                  "CWE-200"
                ],
                "precision": "high",
                "problem.severity": "low"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "missing-permissions-policy",
              "name": "Missing Permissions-Policy header",
              "shortDescription": {
                "text": "Missing Permissions-Policy header"
              },
              "fullDescription": {
                "text": "No Permissions-Policy header restricts access to browser features."
              },
              "helpUri": "",
              "properties": {
                "tags": [],
                "cwe": [
                  "CWE-16"
                ],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "missing-csp",
          "level": "warning",
          "message": {
            "text": "No Content-Security-Policy header is present. This increases XSS risk."
          },
          "fingerprints": {
            "securedeploy/v1": "v1:sha256:aec0a4061e0ea35f99180e81fd643ab085b5ba82641c3b28e54cb8ad5fea3e1b"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://clinicstaff.md-hq.com"
                }
              }
            }
          ],
          "fixes": [
            {
              "description": {
                "text": "Implement a Content-Security-Policy. Start with a report-only policy."
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "confidence": "high",
            "cwe": [
              "CWE-79"
            ],
            "owasp": [],
