    {
      "tool": {
        "driver": {
          "name": "nuclei",
          "informationUri": "https://github.com/securedeploy/securedeploy",
          "version": "0.1.0",
          "rules": [
            {
              "id": "browserconfig-xml",
              "name": "Browser Configuration \"browserconfig.xml\" Exposure",
              "shortDescription": {
                "text": "Browser Configuration \"browserconfig.xml\" Exposure"
              },
              "fullDescription": {
                "text": "Browser Configuration \"browserconfig.xml\" File was exposed.\n"
              },
              "helpUri": "https://www.sygnal.com/lessons/browserconfig-xml",
              "properties": {
                "tags": [
                  "browserconfig",
                  "misconfig",
                  "vuln"
                ],
                "cwe": [],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "ssl-issuer",
              "name": "Detect SSL Certificate Issuer",
              "shortDescription": {
                "text": "Detect SSL Certificate Issuer"
              },
              "fullDescription": {
                "text": "Extract the issuer's organization from the target's certificate. Issuers are entities which sign and distribute certificates.\n"
              },
              "helpUri": "",
              "properties": {
                "tags": [
                  "ssl",
                  "tls",
                  "discovery"
                ],
                "cwe": [],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "http-missing-security-headers",
              "name": "HTTP Missing Security Headers",
              "shortDescription": {
                "text": "HTTP Missing Security Headers"
              },
              "fullDescription": {
                "text": "This template searches for missing HTTP security headers. The impact of these missing headers can vary.\n"
              },
              "helpUri": "",
              "properties": {
                "tags": [
                  "misconfig",
                  "headers",
                  "generic",
                  "vuln"
                ],
                "cwe": [
                  "cwe-693"
                ],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "inertiajs-detect",
              "name": "Inertia.js - Detect",
              "shortDescription": {
                "text": "Inertia.js - Detect"
              },
              "fullDescription": {
                "text": "Detected Inertia.js passively using a single plain GET request with no special headers. It matched four server-emitted Inertia-specific signals on the initial document: three proximity-bound body patterns covering the embedded page object formats and one `Vary: X-Inertia` response header signal set by supported middleware adapters.\n"
              },
              "helpUri": "https://inertiajs.com/",
              "properties": {
                "tags": [
                  "tech",
                  "inertiajs",
                  "inertia"
                ],
                "cwe": [],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "missing-cookie-samesite-strict",
              "name": "Missing Cookie SameSite Strict",
              "shortDescription": {
                "text": "Missing Cookie SameSite Strict"
              },
              "fullDescription": {
                "text": "Identified cookies that lacked the samesite=strict attribute, which prevented enforcement of restrictions on cross-domain cookie transmission.\n"
              },
              "helpUri": "https://pulsesecurity.co.nz/articles/samesite-lax-csrf",
              "properties": {
                "tags": [
                  "misconfig",
                  "samesite",
                  "cookie",
                  "vuln"
                ],
                "cwe": [
                  "cwe-693"
                ],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "missing-sri",
              "name": "Missing Subresource Integrity",
              "shortDescription": {
                "text": "Missing Subresource Integrity"
              },
              "fullDescription": {
                "text": "Checks if external script and stylesheet tags in the HTML response are missing the Subresource Integrity (SRI) attribute.\n"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Third_Party_Javascript_Management_Cheat_Sheet.html#subresource-integrity",
              "properties": {
                "tags": [
                  "compliance",
                  "js",
                  "css",
                  "sri",
                  "misconfig",
                  "vuln"
                ],
                "cwe": [
                  "cwe-353"
                ],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "ssl-dns-names",
              "name": "SSL DNS Names",
              "shortDescription": {
                "text": "SSL DNS Names"
              },
              "fullDescription": {
                "text": "Extract the Subject Alternative Name (SAN) from the target's certificate. SAN facilitates the usage of additional hostnames with the same certificate.\n"
              },
              "helpUri": "",
              "properties": {
                "tags": [
                  "ssl",
                  "tls",
                  "vuln"
                ],
                "cwe": [],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "tls-version",
              "name": "TLS Version - Detect",
              "shortDescription": {
                "text": "TLS Version - Detect"
              },
              "fullDescription": {
                "text": "TLS version detection is a security process used to determine the version of the Transport Layer Security (TLS) protocol used by a computer or server.\nIt is important to detect the TLS version in order to ensure secure communication between two computers or servers.\n"
              },
              "helpUri": "",
              "properties": {
                "tags": [
                  "ssl",
                  "tls",
                  "discovery"
                ],
                "cwe": [],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "waf-detect",
              "name": "WAF Detection",
              "shortDescription": {
                "text": "WAF Detection"
              },
              "fullDescription": {
                "text": "A web application firewall was detected."
              },
              "helpUri": "https://github.com/Ekultek/WhatWaf",
              "properties": {
                "tags": [
                  "waf",
                  "tech",
                  "misc",
                  "discovery"
                ],
                "cwe": [
                  "cwe-200"
                ],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "tech-detect",
              "name": "Wappalyzer Technology Detection",
              "shortDescription": {
                "text": "Wappalyzer Technology Detection"
              },
              "fullDescription": {
                "text": "Wappalyzer Technology Detection"
              },
              "helpUri": "",
              "properties": {
                "tags": [
                  "tech",
                  "discovery"
                ],
                "cwe": [],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "wildcard-tls",
              "name": "Wildcard TLS Certificate",
              "shortDescription": {
                "text": "Wildcard TLS Certificate"
              },
              "fullDescription": {
                "text": "Checks a sites certificate to see if there are wildcard CN or SAN entries.\n"
              },
              "helpUri": "https://cheatsheetseries.owasp.org/cheatsheets/Transport_Layer_Security_Cheat_Sheet.html#carefully-consider-the-use-of-wildcard-certificates",
              "properties": {
                "tags": [
                  "ssl",
                  "tls",
                  "wildcard",
                  "vuln"
                ],
                "cwe": [],
                "precision": "high",
                "problem.severity": "informational"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            }
          ]
        }
